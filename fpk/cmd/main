#!/bin/bash
# 应用生命周期：Docker Compose 由应用中心负责启停，这里只负责
#   1) status：告诉应用中心面板容器是否在运行
#   2) start / stop：连带启动 / 停止面板动态创建出来的 QQ 容器
PANEL_NAME="qqfarm-panel"

case "$1" in
start)
    ids=$(docker ps -aq --filter "label=qqfarm.account" 2>/dev/null)
    if [ -n "$ids" ]; then
        docker start $ids >/dev/null 2>&1 || true
    fi
    exit 0
    ;;
stop)
    ids=$(docker ps -q --filter "label=qqfarm.account" 2>/dev/null)
    if [ -n "$ids" ]; then
        docker stop -t 10 $ids >/dev/null 2>&1 || true
    fi
    exit 0
    ;;
status)
    status=$(docker inspect -f '{{.State.Status}}' "$PANEL_NAME" 2>/dev/null)
    if [ "$status" = "running" ]; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
