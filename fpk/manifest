appname               = qqfarm
version               = 1.0.0
display_name          = QQ 多开挂机
desc                  = 在飞牛 NAS 上同时常驻多个 QQ 账号：每个账号一个独立的官方 Linux QQ 客户端容器，浏览器里通过网页桌面扫码登录，登录态持久化在 Docker 数据卷中。<br>自带中文管理面板，可随时新增 / 删除账号、启停、查看日志与容器状态。<br><br><b>资源提示：</b>官方 QQ 客户端是 Electron 应用，单个账号建议预留 1GB 以上内存与 1GB /dev/shm，请根据 NAS 内存量力而行。<br><b>安全提示：</b>管理面板需要访问 Docker Socket，仅建议在可信局域网使用；首次打开请设置管理密码，并为每个 QQ 实例保留自动生成的 VNC 密码。<br><b>风险提示：</b>长期在服务器环境挂机可能触发 QQ 风控或需要重新登录，重要账号请谨慎使用。<br>本应用为第三方工具，与腾讯无关；QQ 客户端版权归腾讯所有，镜像由社区项目 libzonda/Linux-QQ-release 维护。
platform              = all
source                = thirdparty
maintainer            = QQFarm
maintainer_url        = https://github.com/libzonda/Linux-QQ-release
distributor           = QQFarm
os_min_version        = 1.1.8
desktop_uidir         = ui
desktop_applaunchname = qqfarm.Application
service_port          = 8787
checkport             = true
ctl_stop              = true
disable_authorization_path = true
changelog             = 首个版本：多账号容器管理、网页桌面扫码登录、状态与日志、独立登录数据卷。
