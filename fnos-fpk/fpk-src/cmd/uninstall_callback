#!/bin/bash
set -u

# 只有用户在卸载向导里明确选择删除数据时才清理账号、运行环境与配置。
if [ "${wizard_delete_data:-false}" = "true" ]; then
  rm -rf "${TRIM_PKGVAR}/accounts" \
         "${TRIM_PKGVAR}/runtime" \
         "${TRIM_PKGVAR}/logs" \
         "${TRIM_PKGVAR}/config.json" \
         "${TRIM_PKGVAR}/config.json.tmp" \
         "${TRIM_PKGVAR}/app.pid" \
         "${TRIM_PKGVAR}/access-password" 2>/dev/null || true
fi

exit 0
