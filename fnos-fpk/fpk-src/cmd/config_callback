#!/bin/bash
set -u

if [ "${wizard_clear_password:-false}" = "true" ]; then
  rm -f "${TRIM_PKGVAR}/access-password" 2>/dev/null || true
elif [ -n "${wizard_access_password:-}" ]; then
  umask 077
  printf '%s' "$wizard_access_password" > "${TRIM_PKGVAR}/access-password"
  chmod 600 "${TRIM_PKGVAR}/access-password" 2>/dev/null || true
fi

# 密码在进程启动时读取，重启管理面板使其生效。
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "${SCRIPT_DIR}/common.sh" ]; then
  # shellcheck source=common.sh
  . "${SCRIPT_DIR}/common.sh"
  qqnas_stop_manager
  qqnas_start_manager || true
fi

exit 0
