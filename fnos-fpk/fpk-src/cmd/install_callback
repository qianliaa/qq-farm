#!/bin/bash
set -u

mkdir -p "${TRIM_PKGVAR}/accounts" "${TRIM_PKGVAR}/runtime" "${TRIM_PKGVAR}/logs" 2>/dev/null || true

if [ -n "${wizard_access_password:-}" ]; then
  umask 077
  printf '%s' "$wizard_access_password" > "${TRIM_PKGVAR}/access-password"
  chmod 600 "${TRIM_PKGVAR}/access-password" 2>/dev/null || true
fi

# QQ 与 NapCat 在首次添加账号时由管理面板按需安装，避免安装阶段长时间占用应用中心。
exit 0
